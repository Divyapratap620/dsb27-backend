# ─────────────────────────────────────────────────────────────
#  DSB-27 Backend — Environment Variables
#  Copy this file to .env and fill in your values
#  (Never commit .env to git)
# ─────────────────────────────────────────────────────────────

# REQUIRED: Your Groq API key (free at console.groq.com/keys)
GROQ_API_KEY=gsk_your_key_here

# OPTIONAL: Port (default 3000; Render sets this automatically)
# PORT=3000

# OPTIONAL: Your deployed front-end URL for CORS
# Use * to allow all origins (fine for a personal dashboard)
ALLOWED_ORIGIN=*

# OPTIONAL: Where to store user data JSON files
# On Render free tier, /tmp is the only writable path
# Note: /tmp is wiped on restart — data will be lost. Use a database
# (e.g. Render's free PostgreSQL) for permanent storage.
DATA_DIR=/tmp/dsb27-data

# OPTIONAL: Your own deployed backend URL for keep-alive self-ping
# This prevents Render free tier from sleeping during active sessions
# e.g. https://dsb27-backend.onrender.com
SELF_URL=
